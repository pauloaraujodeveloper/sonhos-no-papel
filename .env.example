# Copie para .env e preencha (ou rode `neon env pull`, que grava as variáveis do Neon no .env).
# Nunca faça commit do .env.

# Neon: DATABASE_URL é a conexão do app (host "-pooler"); a UNPOOLED é direta e serve às migrações.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_JWKS_URL=""

# Segredo da sessão do painel (mín. 32 caracteres; também na Vercel). Trocar encerra todas as sessões.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Endereço público do site (metadados e Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
